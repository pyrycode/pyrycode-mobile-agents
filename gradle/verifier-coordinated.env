# Proposed coordinated verifier configuration. Source only for the measured trial.
# Retains every normal gate and the exact named-test comparison commands.
# Existing timeout, environment, host/device admission and input snapshot stay set.
# First deploy the reviewed build-slot hook on hosts that install it globally.
# See docs/verifier-throughput.md for the observed cache incompatibility and proof.
PYRY_VERIFIER_GATES='python3 scripts/pre-verify.py;scripts/docs-guard.sh;python3 -m unittest discover -s scripts;python3 scripts/jvm-test-gate.py --with-build-checks;ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py ui;ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py scripted-all'
PYRY_VERIFIER_GATE_FORMATS='{"python3 scripts/jvm-test-gate.py --with-build-checks":{"format":"junit-xml","baseline":"python3 scripts/jvm-test-gate.py --tests-json {{TESTS_JSON}}"},"ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py ui":{"format":"junit-xml","baseline":"ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py ui --tests {{TESTS}}"},"ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py scripted-all":{"format":"junit-xml","baseline":"ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py scripted-all --tests {{TESTS}}"}}'
export PYRY_VERIFIER_GATES PYRY_VERIFIER_GATE_FORMATS
