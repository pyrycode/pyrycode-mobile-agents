# Copy to .env (gitignored) and fill in.

GITHUB_OWNER=pyrycode
GITHUB_REPO=pyrycode-mobile
PROJECT_NUMBER=
GITHUB_TOKEN=op://Automation/Pyrycode-Dispatcher-PAT/credential
TARGET_REPO_PATH=/absolute/path/to/pyrycode-mobile

# Optional
# TARGET_DEFAULT_BRANCH=master   # default: main
# SALVAGE_GATES="./gradlew assembleDebug"   # default: "go vet ./...; go build ./..." (set the Gradle build gate; the live .env does)
# DISCORD_WEBHOOK_URL="op://Automation/Discord webhook/credential"
# CLAUDE_CODE_OAUTH_TOKEN="op://Automation/Claude long term token/password"
# PYRY_LOG_RETENTION_DAYS=30
# OWNER_TYPE=organization   # default: user

# AGENTS_REPO_PATH is set automatically by bin/pyry-start.

# Stage set. Unset (or "classic") runs the six-agent relay: po, architect,
# developer, qa, code-review, documentation. "builder" runs the four-role set
# piloted on pyrycode since 2026-09-01 and adopted here 2026-09-05: refiner,
# builder, verifier, documentation. Backlog advances straight to In
# Development; In Architecture and In QA are never polled. Rollback is
# unsetting the variable and restarting.
# PYRY_STAGE_SET=builder
# Mobile launcher defaults: two agent slots, one verifier at a time, and
# preliminary Codex source review alongside deterministic gates.
# PYRY_MAX_CONCURRENT=2
# PYRY_VERIFIER_SERIAL=0
# At most two at once (agent-dispatcher#100). A third would only wait on the emulator hold.
# PYRY_VERIFIER_MAX=2
# Two verifiers at once, 2026-10-01. Their emulator checks queue on the device hold rather than running
# side by side, which is what made two overlapping verifiers take 13 to 14 minutes each on 2026-09-22.
# PYRY_VERIFIER_PARALLEL_REVIEW=1
# Mobile effort trial. Requires the builder set. Remove or set off to roll back.
# PYRY_EFFORT_POLICY=role-risk-v1
#
# Deterministic gates the dispatcher runs in the PR worktree BEFORE spawning the
# verifier (builder set only). `;`-separated shell commands, and the whole value
# MUST be quoted: the 1Password wrapper silently drops an unquoted value that
# contains spaces. There is no install step: Gradle resolves dependencies itself,
# and the first call in a fresh worktree is a cold build. `scripts/pre-verify.py`
# goes first and takes seconds: it fails what the verifier would fail on sight, a
# security-sensitive plan with no security review, new theme literals, a
# `## Live tests` list that misses or misnames live methods, and ignored files
# such as AGENTS.md on the branch. A GitHub read it cannot make is skipped, not red.
# `scripts/docs-guard.sh` is next, also fast: it is the parent's docs guard in shell, no false
# headings and no overview over 50000 bytes under docs/knowledge/features. `check` runs the unit
# suite, Android Lint and Spotless; `assembleDebug` proves the APK builds;
# `compileDebugAndroidTestKotlin` proves the instrumented set compiles. The
# UI gate then executes all non-E2E device tests. Each scripted invocation runs
# one real-app scenario with the fake Claude backend. Gradle starts and stops
# its managed Android 13 emulator. Android Studio need not be open.
# Every command has a 10-minute cap. SDK and Java paths must reach the dispatcher
# environment because local.properties does not reach ticket worktrees.
# Green injects a gates-passed note into the verifier; red starts triage.
# PYRY_VERIFIER_GATES="python3 scripts/pre-verify.py;scripts/docs-guard.sh;python3 -m unittest discover -s scripts;./gradlew check;./gradlew assembleDebug;./gradlew compileDebugAndroidTestKotlin;ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py ui;ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py scripted-all"
#
# Sibling sources build isolated test binaries on each E2E invocation, using
# Go's build cache. Production daemon binaries and processes are untouched.
# PYRYCODE_SRC=/absolute/path/to/pyrycode
# PYRYCODE_RELAY_SRC=/absolute/path/to/pyrycode-relay
# ANDROID_HOME=/absolute/path/to/Android/sdk
# JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
#
# For needs-real-claude tickets, after verifier approval and before docs/merge.
# The curated suite executes eight tests and requires the host's Claude login.
# PYRY_REAL_CLAUDE_GATE_CMD="ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py live"
# PYRY_REAL_CLAUDE_GATE_FORMAT=junit-xml
# PYRY_REAL_CLAUDE_GATE_MIN_EXECUTED=8
# PYRY_REAL_CLAUDE_GATE_TIMEOUT_MS=3600000
# PYRY_REAL_CLAUDE_GATE_BASELINE_CMD="ANDROID_GATE_WAIT_SECONDS=2700 python3 scripts/android-test-gate.py live --tests {{TESTS}}"
#
# Background gate (agent-dispatcher#97, 2026-10-01): the live run goes on beside builders, the
# refiner and documentation. Only verifiers and the main sweep wait for it. A builder's device run
# queues on the emulator hold; the gate's own commands wait up to 45 minutes for it, while agents
# keep the script's 5-minute default so their shell calls stay inside their 10-minute limit.
# PYRY_REAL_CLAUDE_GATE_BACKGROUND=1
# The gate also runs beside verifiers (agent-dispatcher#98). Their emulator checks above wait up to
# 45 minutes for the device hold, so each verifier check and live gate gets 60 minutes.
# PYRY_REAL_CLAUDE_GATE_HOLD_VERIFIERS=0
# The verifier's device-only tests run on one emulator. From 2026-10-01 to 2026-10-04, UI_SHARDS=2 split
# them across two, 3m49s against 5.2 minutes on one, but a second emulator cost memory the MacBook lacked
# with three agents and two verifiers running; back to one on 2026-10-05.
# PYRY_VERIFIER_GATE_TIMEOUT_MS=3600000
#
# Per-ticket selection (agent-dispatcher#96, 2026-10-01): run the methods the PR lists
# under "## Live tests" plus three basic flows, not the whole live class. The whole
# class still runs when the diff touches a FULL_PATHS prefix, the list is missing,
# and after 10 merges since the last clean full run.
# PYRY_REAL_CLAUDE_GATE_SELECT=1
# Quoted: 1Password's env-file loader cuts an unquoted value at the first #.
# PYRY_REAL_CLAUDE_GATE_ALWAYS_TESTS="de.pyryco.mobile.e2e.InteractiveStreamE2ETest#interactiveTurn_pingPrompt_streamsPingReplyIntoThread,de.pyryco.mobile.e2e.InteractiveStreamE2ETest#interactiveTurn_offlineRetry_reconnectsSameHostAndReplies,de.pyryco.mobile.e2e.InteractiveStreamE2ETest#interactiveTurn_twoHostsCollidingConversationId_stayPerHost"
# PYRY_REAL_CLAUDE_GATE_FULL_PATHS=app/src/main/java/de/pyryco/mobile/data/network/,app/src/main/java/de/pyryco/mobile/data/crypto/,app/src/main/java/de/pyryco/mobile/di/RelayConnection,app/src/main/java/de/pyryco/mobile/lifecycle/,app/src/main/java/com/southernstorm/noise/,app/src/androidTest/java/de/pyryco/mobile/e2e/E2e,app/src/androidTest/java/de/pyryco/mobile/e2e/SecondClientPeer.kt,app/src/androidTest/java/de/pyryco/mobile/e2e/DaemonFaultControl.kt,app/src/androidTest/java/de/pyryco/mobile/e2e/ActivityIntentStub.kt,app/src/androidTest/java/de/pyryco/mobile/e2e/FocusRecordListener.kt,app/src/sharedTest/java/de/pyryco/mobile/e2e/,app/build.gradle.kts,gradle/libs.versions.toml
# PYRY_REAL_CLAUDE_GATE_FULL_EVERY=10
#
# Main sweep: every screen test on two emulators, against main, when the board is
# idle or after 10 merges; an idle run resets the count. The verifier's ui gate runs only the device-only classes;
# the shared screen tests run under Robolectric in ./gradlew check. UI_GATE_FULL
# stops the docs-only skip from ever skipping a sweep. A failure files a Backlog ticket.
# PYRY_MAIN_SWEEP_CMD="UI_GATE_FULL=1 UI_DEVICE_ALL=1 python3 scripts/android-test-gate.py ui"
# PYRY_MAIN_SWEEP_FORMAT=junit-xml
# PYRY_MAIN_SWEEP_EVERY=10
#
# Family circuit breaker: dispatches per ticket family (root + every split
# descendant) before the family is parked under error:family-breaker. The code
# default of 24 fired on a pyrycode family that was completing normally; 60
# sits near the ~66 dispatches the worst observed spiral reached.
# PYRY_FAMILY_DISPATCH_LIMIT=60

# Shared project knowledge replaces private Claude memory.
CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
PYRY_AUTOCURATE_MEMORY=0
# Optional saved runner. Override one launch with bin/pyry-start --runner codex.
# PYRY_AGENT_RUNNER=claude
# PYRY_CODEX_MODEL=
# PYRY_CODEX_EFFORT=
# Builder wall-clock override. The Mobile launcher defaults to 70 minutes.
# PYRY_BUILDER_TIMEOUT_MINUTES=70

# Environment variables the dispatcher cannot work without (agent-dispatcher#110, 2026-10-04).
# While one is missing or blank, no agent, live gate or main sweep starts, and one warning is sent.
PYRY_REQUIRED_ENV=ANDROID_HOME

# Non-secret settings passed to Codex agents' shell commands (agent-dispatcher#111, 2026-10-04).
# Codex gives tool commands only core variables, so without this agents cannot see these paths.
PYRY_AGENT_SHELL_ENV=ANDROID_HOME,JAVA_HOME,PYRYCODE_SRC,PYRYCODE_RELAY_SRC

# Builder-only live repairs. A separate service account that reads only Dev agents.
# Never use the main Automation account here. Not part of PYRY_AGENT_SHELL_ENV.
# PYRY_DEV_AGENTS_TOKEN="op://Automation/xcl7xsu5ppbww3m5gav7wmbt6e/credential"
